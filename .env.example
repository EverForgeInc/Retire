# Local development default uses SQLite (no Docker required).
DATABASE_URL="file:./dev.db"
# Closed beta production must use a managed PostgreSQL DATABASE_URL.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Use at least 32 random characters. Never commit the real production value.
AUTH_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"

# Required in production for invitation-only closed beta registration.
# Use a unique value of at least 8 characters and distribute it only to invited testers.
BETA_ACCESS_CODE="local-beta"

ALLOW_MEDICAL_UPLOADS="false"

# LOCAL SEED ONLY. Do not use shared demo credentials in production.
DEMO_USER_EMAIL="david@example.com"
DEMO_USER_PASSWORD="changeme123"
